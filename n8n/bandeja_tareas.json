    },
    {
      "parameters": {
        "jsCode": "// Guarda el envío en la bandeja (datos estáticos del flujo).\n// Ojo: solo persiste en ejecuciones de producción (flujo activo), no en pruebas.\nconst bandeja = $getWorkflowStaticData('global');\nbandeja.pendientes = bandeja.pendientes || [];\nbandeja.seq = (bandeja.seq || 0) + 1;\n\nconst f = $input.first().json;\nconst item = {\n  id: `B-${Date.now().toString(36)}-${bandeja.seq}`,\n  recibido: new Date().toISOString(),\n  tarea: String(f['Tarea'] || '').trim(),\n  proyecto: f['Proyecto'] || '',\n  detalle: String(f['Detalle'] || '').trim(),\n  fecha: f['Para cuándo'] || '',\n  prioridad: f['Prioridad'] || 'Normal',\n};\nbandeja.pendientes.push(item);\n\nreturn [{ json: { ok: true, id: item.id, en_bandeja: bandeja.pendientes.length } }];"
      },
      "id": "a89b6b79-98be-4b8d-95f4-efc5a87618e0",
      "name": "Guardar en bandeja",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "gantt-bandeja",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "3c672dbd-f7ab-4851-ae90-087ce268b3c0",
      "name": "Webhook: leer bandeja",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 220],
      "webhookId": "3c672dbd-f7ab-4851-ae90-087ce268b3c0"
    },
    {
      "parameters": {
        "jsCode": "// Devuelve lo que está en la bandeja, sin borrarlo.\nconst bandeja = $getWorkflowStaticData('global');\nreturn [{ json: { pendientes: bandeja.pendientes || [] } }];"
      },
      "id": "4bff75b4-6aa9-4784-b68d-ef9600fe93d8",
      "name": "Listar pendientes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 220]
    },
