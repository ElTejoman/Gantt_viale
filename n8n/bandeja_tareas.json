        "options": {}
      },
      "id": "8c19bc5d-5796-42ae-a02f-8d0ee4d64290",
      "name": "Webhook: confirmar recibidas",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 440],
      "webhookId": "8c19bc5d-5796-42ae-a02f-8d0ee4d64290"
    },
    {
      "parameters": {
        "jsCode": "// El Gantt ya guardó estas tareas en su lado: se sacan de la bandeja.\nconst bandeja = $getWorkflowStaticData('global');\nconst cuerpo = $input.first().json.body || {};\nconst ids = new Set(Array.isArray(cuerpo.ids) ? cuerpo.ids : []);\nconst antes = (bandeja.pendientes || []).length;\nbandeja.pendientes = (bandeja.pendientes || []).filter((p) => !ids.has(p.id));\nreturn [{ json: { ok: true, quitadas: antes - bandeja.pendientes.length, quedan: bandeja.pendientes.length } }];"
      },
      "id": "0d7f2b1e-6a43-4c55-9b0a-2f9e8c1d3a47",
      "name": "Sacar de la bandeja",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 440]
    }
  ],
